COMPOSE_PROJECT_NAME=microservices
CONFIGSERVER_IMAGE=ggoutos/configserver:jib
ACCOUNTS_IMAGE=ggoutos/accounts:jib
CARDS_IMAGE=ggoutos/cards:jib
LOANS_IMAGE=ggoutos/loans:jib
MYSQL_ROOT_PASSWORD=root
SPRING_PROFILES_ACTIVE=default
SPRING_RABBITMQ_HOST=rabbit
SPRING_CLOUD_CONFIG_URI=http://configserver:8071

## The following variables should be set in .env.local and .env.prod, but are left blank here for security reasons.
#CONFIG_SERVER_PASSWORD=
#CONFIG_SERVER_USER=
#GIT_TOKEN=
#GIT_URI=
#GIT_USERNAME=
#ENCRYPTION_KEY=