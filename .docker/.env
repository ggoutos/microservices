COMPOSE_PROJECT_NAME=microservices
IMAGE_TAG=jib
SPRING_PROFILES_ACTIVE=default
CONFIG_SERVER_HOST=configserver
EUREKA_SERVER_HOST=eurekaserver
RABBITMQ_HOST=rabbit
KAFKA_HOST=kafka
REDIS_HOST=redis
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
SPRING_CLOUD_STREAM_DEAFULT_BINDER=kafka

JAVA_TOOL_OPTIONS='-javaagent:/app/libs/opentelemetry-javaagent-2.26.1.jar'
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

######### The following variables !!should be set!! in .env.local and .env.prod, #########
##########           but are left blank here for security reasons.          ##############
#MYSQL_ROOT_PASSWORD=
#CONFIG_SERVER_PASSWORD=
#CONFIG_SERVER_USER=
#GIT_TOKEN=
#GIT_URI=
#GIT_USERNAME=
#ENCRYPTION_KEY=